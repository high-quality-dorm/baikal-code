# Подключение к базе (app_owner создаётся как POSTGRES_USER)
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=owner
POSTGRES_DB=university
POSTGRES_PORT=5432

# Пароли ролей приложения
APP_RO_PASSWORD=ro_secret
APP_ADMIN_PASSWORD=admin_secret
APP_AUDIT_PASSWORD=audit_secret

# Подпись JWT (RS256): закрытый ключ и сертификат генерируются командой `make certs`.
# Для продакшена замените пути на свои ключи (или сгенерируйте свои).
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=certs/jwt-private-key.pem
JWT_PUBLIC_KEY_PATH=certs/jwt-cert.pem

# Строки подключения
DATABASE_URL_OWNER=postgresql://app_owner:owner@localhost:5432/university
DATABASE_URL_RO=postgresql://app_ro:ro_secret@localhost:5432/university
DATABASE_URL_ADMIN=postgresql://app_admin:admin_secret@localhost:5432/university
DATABASE_URL_AUDIT=postgresql://app_audit:audit_secret@localhost:5432/university
