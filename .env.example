# Подключение к базе (app_owner создаётся как POSTGRES_USER)
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=owner
POSTGRES_DB=university
POSTGRES_PORT=5432

# Пароли ролей приложения
APP_RO_PASSWORD=ro_secret
APP_SERVICE_PASSWORD=service_secret

# Подпись JWT (RS256): закрытый ключ и сертификат генерируются командой `make certs`.
# Для продакшена замените пути на свои ключи (или сгенерируйте свои).
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=certs/jwt-private-key.pem
JWT_PUBLIC_KEY_PATH=certs/jwt-cert.pem

# Строки подключения
DATABASE_URL_OWNER=postgresql://app_owner:owner@localhost:5432/university
DATABASE_URL_RO=postgresql://app_ro:ro_secret@localhost:5432/university
DATABASE_URL_SERVICE=postgresql://app_service:service_secret@localhost:5432/university

# LLM (OpenAI-совместимый API) для генерации SQL и пересказа ответа.
# Заполните реальные значения. Примеры провайдеров:
#   DeepSeek:    base_url=https://api.deepseek.com, model=deepseek-chat
#   OpenAI:      base_url=https://api.openai.com/v1, model=gpt-4o-mini
#   Локальный:   base_url=http://localhost:8000/v1 (vLLM/Ollama-прокси)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0

# Тул-агент: максимум шагов LLM-цикла на вопрос (включая вызовы тулов).
AGENT_MAX_STEPS=5
