# Baikal: производственное окружение. ЕДИНЫЙ файл деплоя.
# Скопируйте в .env и заполните реальные значения:
#   cd deploy && make setup   (или: cp .env.example .env)
# НЕ коммитьте .env с секретами.
#
# Роль файла: .env читается docker compose для подстановки ${...} в
# docker-compose.yml (CERT_DIR) И передаётся в контейнер backend через
# env_file: .env. Поэтому все настройки — БД, JWT, LLM, nginx — в одном месте.
#
# ВАЖНО: если значение содержит '$', экранируйте его как '$$' — compose
# интерпретирует ${...} при подстановке. Надёжнее всего пароли без '$'.

# --- База данных (внешняя) ---
# Приложение использует две роли: read-only (app_ro) и служебную (app_service).
# DSN указывают на удалённый PostgreSQL-сервер (НЕ на localhost).
DATABASE_URL_RO=postgresql://app_ro:CHANGE_ME@db.example.com:5432/university
DATABASE_URL_SERVICE=postgresql://app_service:CHANGE_ME@db.example.com:5432/university

# Только для разовой настройки внешней БД с этого сервера (make db-init):
# применяет db/01_schema.sql, db/02_roles.sql, db/03_rls.sql, db/04_views.sql.
# Приложение этот URL НЕ использует; после настройки строку можно удалить.
# DATABASE_URL_OWNER=postgresql://app_owner:CHANGE_ME@db.example.com:5432/university

# --- Подпись JWT (RS256) ---
# Ключи монтируются volume'ом (../certs), пути относительны WORKDIR /app в контейнере.
# Генерируются автоматически: make setup (см. deploy/Makefile, target certs).
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=certs/jwt-private-key.pem
JWT_PUBLIC_KEY_PATH=certs/jwt-cert.pem

# --- LLM (OpenAI-совместимый API) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0

# --- Тул-агент ---
AGENT_MAX_STEPS=5

# --- Rate limiting для /ask (in-process, один worker) ---
RATE_LIMIT_USER_REQUESTS=30
RATE_LIMIT_GUEST_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Nginx / TLS ---
# Директория с TLS-сертификатами fullchain.pem и privkey.pem (монтируется в nginx).
# Обязательная переменная: compose упадёт с понятной ошибкой, если не задана
# (guard ${CERT_DIR:?} в docker-compose.yml).
CERT_DIR=/path/to/ssl