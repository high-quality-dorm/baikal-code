# Продакшен-конфигурация Baikal. Скопируйте в .env.prod и заполните реальные
# значения. НЕ коммитьте .env.prod с секретами.
#
# БД внешняя: DSN указывают на удалённый PostgreSQL-сервер (НЕ на localhost).
# Приложение использует две роли: read-only (app_ro) и служебную (app_service).
# Роль app_owner нужна только для одноразового применения схемы/ролей/RLS
# (db/*.sql), в контейнер не передаётся.

# --- База данных (роли приложения) ---
DATABASE_URL_RO=postgresql://app_ro:CHANGE_ME@db.example.com:5432/university
DATABASE_URL_SERVICE=postgresql://app_service:CHANGE_ME@db.example.com:5432/university

# --- Подпись JWT (RS256) ---
# Ключи монтируются volume'ом (certs/), пути относительны WORKDIR /app в контейнере.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=certs/jwt-private-key.pem
JWT_PUBLIC_KEY_PATH=certs/jwt-cert.pem

# --- LLM (OpenAI-совместимый API) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0

# --- Тул-агент ---
AGENT_MAX_STEPS=5

# --- Rate limiting для /ask (in-process, один worker) ---
RATE_LIMIT_USER_REQUESTS=30
RATE_LIMIT_GUEST_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Nginx (см. docker-compose.yml) ---
# Директория с сертификатами fullchain.pem / privkey.pem (монтируется в nginx).
CERT_DIR=/path/to/ssl
